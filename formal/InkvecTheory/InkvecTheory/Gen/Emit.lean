import InkvecTheory.Gen.Strip
import InkvecTheory.Gen.Design

/-!
# Writing the generated Rust

Run from `formal/InkvecTheory`:

    lake build InkvecTheory && lake env lean InkvecTheory/Gen/Emit.lean

It writes every module of `generatedModules` to `crates/inkvec-verified/src/generated/`. CI
runs it and fails when the files it writes differ from the committed ones, so the Rust
cannot drift from the definitions the theorems are about. Not imported by the library: a
build has no side effects.
-/

namespace Inkvec.Gen

/-- Each generated module: file stem, the Lean declarations it comes from, its kernels. -/
def generatedModules : List (String × String × List Kernel) :=
  [("strip", "InkvecTheory.Gen.Strip (stripKernels)", stripKernels),
   ("design", "InkvecTheory.Gen.Design (designKernels)", designKernels)]

/-- The generated directory's `mod.rs`. Each module is `#[rustfmt::skip]`: it is compared
byte for byte with what this file prints, so no formatter may touch it. -/
def modRs : String :=
  "// @generated by `lake env lean InkvecTheory/Gen/Emit.lean` (formal/InkvecTheory). Do not edit.
//! Kernels generated from the Lean definitions their theorems are about.

" ++ String.intercalate "" (generatedModules.map (fun (n, _, _) => s!"#[rustfmt::skip]\npub mod {n};\n"))

end Inkvec.Gen

open Inkvec.Gen in
#eval show IO Unit from do
  let dir : System.FilePath := "../../crates/inkvec-verified/src/generated"
  IO.FS.createDirAll dir
  IO.FS.writeFile (dir / "mod.rs") modRs
  for (n, src, ks) in generatedModules do
    IO.FS.writeFile (dir / s!"{n}.rs") (module src ks)
  IO.println s!"wrote {generatedModules.length} generated module(s) to {dir}"
