      "input": "tiny.png",
      "form": "encoded",
      "options": {},
      "expect": {
        "width": 96,
        "height": 96
      },
      "svg": {
        "x86_64-windows-msvc": {
          "bytes": 9378,
          "sha256": "64a2b0457e75f844e683e968696868132bb8d41e93f2eb57e20b89f8ef0a9412"
