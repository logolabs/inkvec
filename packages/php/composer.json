{
    "name": "logolabs/inkvec",
    "description": "Raster logos, icons and illustrations to compact, accurate SVG: the PHP binding for the Inkvec tracer, over its C ABI through FFI.",
    "keywords": ["svg", "vector", "vectorize", "vectorizer", "tracer", "logo", "image", "ffi", "raster-to-vector"],
    "homepage": "https://github.com/logolabs/inkvec",
    "license": "Apache-2.0",
    "type": "library",
    "authors": [
        {
            "name": "LogoLabs",
            "homepage": "https://github.com/logolabs"
        }
    ],
    "support": {
        "issues": "https://github.com/logolabs/inkvec/issues",
        "source": "https://github.com/logolabs/inkvec",
        "docs": "https://github.com/logolabs/inkvec/blob/main/docs/BINDINGS.md"
    },
    "require": {
        "php": ">=8.1",
        "ext-ffi": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "LogoLabs\\Inkvec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LogoLabs\\Inkvec\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/inkvec-fetch-library"],
    "scripts": {
        "test": "phpunit",
        "fetch-library": "@php bin/inkvec-fetch-library"
    },
    "config": {
        "sort-packages": true
    }
}
