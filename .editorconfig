root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.{toml,cff}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{json,js,mjs,cjs,ts}]
indent_size = 2

[*.{html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.svg]
indent_size = 2
