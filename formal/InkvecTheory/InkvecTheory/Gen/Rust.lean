import InkvecTheory.Gen.Expr

/-!
# Printing kernels as Rust

A `Kernel` is a named list of `Expr` outputs over `arity` inputs. Each is printed three ways
into `crates/inkvec-verified/src/generated/`:

* `<name>_f64`: the formula in `f64`, fully parenthesised so Rust evaluates it in exactly
  the order of the `Expr` (the solvers' fast path; the same formula the theorem is about,
  rounded).
* `<name>_iv`: `Expr.evalI` through the runtime's outward-rounded intervals (`iv.rs`); what it
  returns contains the real value (`Expr.evalI_sound`).
* `<name>_q`: `Expr.evalQ` through the runtime's checked `i128` rationals (`q.rs`); what it
  returns is the real value (`Expr.evalQ_sound`).

The printer is trusted, as a compiler is: it maps each constructor to one runtime call or
one Rust operator, and nothing else.
-/

namespace Inkvec.Gen

/-- A generated kernel. -/
structure Kernel where
  /-- The Rust function stem. -/
  name : String
  /-- One line on what it computes, and the Lean declaration its theorem is about. -/
  doc : String
  /-- Number of inputs `x[0..arity]`. -/
  arity : Nat
  /-- The outputs. -/
  outs : List Expr

namespace Expr

/-- A rational literal as Rust `f64` source. -/
def litF64 (q : ℚ) : String :=
  let n := if q.num < 0 then s!"(-{q.num.natAbs}.0)" else s!"{q.num.natAbs}.0"
  if q.den = 1 then n else s!"({n} / {q.den}.0)"

/-- The `f64` formula, fully parenthesised. -/
def rustF64 : Expr → String
  | lit q => litF64 q
  | var i => s!"x[{i}]"
  | neg a => s!"(-{rustF64 a})"
  | add a b => s!"({rustF64 a} + {rustF64 b})"
  | sub a b => s!"({rustF64 a} - {rustF64 b})"
  | mul a b => s!"({rustF64 a} * {rustF64 b})"
  | div a b => s!"({rustF64 a} / {rustF64 b})"
  | sqrt a => s!"{rustF64 a}.sqrt()"

/-- A literal's numerator and denominator as Rust `i128` arguments. -/
def litArgs (q : ℚ) : String := s!"{q.num}, {q.den}"

/-- The interval evaluation: one runtime call per constructor, `?` on each refusal. -/
def rustIv : Expr → String
  | lit q => s!"iv::lit({litArgs q})?"
  | var i => s!"x[{i}]"
  | neg a => s!"iv::neg({rustIv a})?"
  | add a b => s!"iv::add({rustIv a}, {rustIv b})?"
  | sub a b => s!"iv::sub({rustIv a}, {rustIv b})?"
  | mul a b => s!"iv::mul({rustIv a}, {rustIv b})?"
  | div a b => s!"iv::div({rustIv a}, {rustIv b})?"
  | sqrt a => s!"iv::sqrt({rustIv a})?"

/-- The exact rational evaluation: one runtime call per constructor, `?` on each refusal
(an overflow, a division by zero, a square root). -/
def rustQ : Expr → String
  | lit q => s!"q::lit({litArgs q})?"
  | var i => s!"x[{i}]"
  | neg a => s!"q::neg({rustQ a})?"
  | add a b => s!"q::add({rustQ a}, {rustQ b})?"
  | sub a b => s!"q::sub({rustQ a}, {rustQ b})?"
  | mul a b => s!"q::mul({rustQ a}, {rustQ b})?"
  | div a b => s!"q::div({rustQ a}, {rustQ b})?"
  | sqrt _ => "None?"

end Expr

namespace Kernel

private def joinOuts (f : Expr → String) (outs : List Expr) : String :=
  String.intercalate ",\n        " (outs.map f)

/-- The three Rust functions of a kernel. -/
def rust (k : Kernel) : String :=
  let n := k.outs.length
  s!"/// {k.doc}
#[inline]
pub fn {k.name}_f64(x: &[f64; {k.arity}]) -> [f64; {n}] \{
    [
        {joinOuts Expr.rustF64 k.outs},
    ]
}

/// [`{k.name}_f64`] as an enclosure: contains the exact value, or `None` (a refusal).
pub fn {k.name}_iv(x: &[Iv; {k.arity}]) -> Option<[Iv; {n}]> \{
    Some([
        {joinOuts Expr.rustIv k.outs},
    ])
}

/// [`{k.name}_f64`] exactly, or `None` (an overflow, a division by zero, a square root).
pub fn {k.name}_q(x: &[Q; {k.arity}]) -> Option<[Q; {n}]> \{
    Some([
        {joinOuts Expr.rustQ k.outs},
    ])
}
"

end Kernel

/-- A generated Rust module: its header and kernels. -/
def module (source : String) (kernels : List Kernel) : String :=
  s!"// @generated by `lake env lean InkvecTheory/Gen/Emit.lean` (formal/InkvecTheory) from
// `{source}`. Do not edit: CI regenerates this file and fails on any difference.
#![allow(clippy::all, unused_parens, unused_variables, missing_docs)]

use crate::iv::\{self, Iv};
use crate::q::\{self, Q};

" ++ String.intercalate "\n" (kernels.map Kernel.rust)

end Inkvec.Gen
