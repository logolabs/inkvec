      "name": "tiny_defaults",
      "input": "tiny.png",
      "form": "encoded",
      "options": {},
      "expect": {
        "width": 96,
        "height": 96
      },
      "svg": {
        "x86_64-windows-msvc": {
          "bytes": 9390,
          "sha256": "e6ca24eba98ebe6274ec3ae9e12e6bf45d0461c01043a2cf26fd21ef2281c5f6"
        }
      }
    },
