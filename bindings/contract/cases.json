      "name": "tiny_defaults",
      "input": "tiny.png",
      "form": "encoded",
      "options": {},
      "expect": {
        "width": 96,
        "height": 96
      },
      "svg": {
        "x86_64-linux-gnu": {
          "bytes": 8128,
          "sha256": "4bb1adaf919c295fc7cb05b4a175d3523503c830bde22d594b1e702a015a2716"
        }
