{
  "name": "inkvec-studio",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "description": "Inkvec Studio: turn a raster logo into an SVG, exactly. The desktop app (Tauri) and its browser build, Inkvec Studio Lite.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "mock": "vite --open /dev/index.html",
    "build": "tsc --noEmit && vite build",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "vite --mode web",
    "serve:web": "python web/serve.py",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar": "node scripts/sidecar.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
