# Benchmark data: corpora, traced outputs, scores, reports. All regenerable. The 246-icon
# screen set the CI gate needs is force-added (`git add -f`) and stays tracked.
bench/data/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Rust. Parallel target dirs exist so a measurement running out of one binary cannot be
# invalidated by a rebuild of another -- Windows locks a running exe, and an A/B whose
# control gets rebuilt mid-run is worse than no A/B at all.
target/
target[0-9]*/
target-*/
**/*.rs.bk

# Model weights and exports. Distributed as release assets, never committed.
*.onnx
*.bpk
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
crates/inkvec-restore/models/

# Third-party benchmark tools and runtimes (Potrace is GPL; ONNX Runtime ships its own
# notices). Local only, never redistributed from this repository. tools/vendor/.gitignore
# says the same, but it ignores itself, so a fresh clone would not have it.
tools/vendor/
# The research SR comparisons download waifu2x-ncnn-vulkan (an executable plus its weights)
# here; like tools/vendor/, it is run locally and never redistributed.
bench/research/tools/

# Internal material that must not be published.
docs/legal/
docs/research/
docs/research-notes/
bench/research/
evolve/
gradio_app/
release/
ai_trace.py
ORIGINAL_REQUEST.md
handoff*.md
HANDOFF*.md

# Generated outputs
/output/
out/
/site/

# Local working areas and tool state
scratch/
.agents/
.claude/
wandb/
*.log

# Archives and secrets
*.zip
.env
.env.*
*.pem
*.key
*.token
*.p8
*.p12
*id_rsa*
*.secret
credentials.json
client_secret*.json

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Node (web tooling, if any is installed locally)
node_modules/
